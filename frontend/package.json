{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "deploy:production": "bash scripts/deploy-production.sh",
    "start": "next start",
    "lint": "eslint .",
    "test:edge-media": "echo 'MSE regression removed — use test:edge-native-range'",
    "test:edge-native-range": "node scripts/edge-native-range-regression.mjs",
    "test:mkv-drift": "node scripts/mkv-drift-regression.mjs",
    "test:sdp-ac3-stress": "node scripts/sdp-ac3-stress-regression.mjs",
    "test:seek-patient": "node scripts/seek-stress-test.mjs --mode=patient",
    "test:seek-rapid": "node scripts/seek-stress-test.mjs --mode=rapid",
    "bench:buffer": "node scripts/buffer-benchmark.mjs",
    "test:e2e": "npx playwright test",
    "smoke:share-faststart": "node scripts/share-virtual-faststart-smoke.mjs",
    "smoke:share-ac3": "node scripts/share-ac3-smoke.mjs",
    "smoke:share-ac3-seek": "SHARE_RAPID_SEEK=1 node scripts/share-ac3-smoke.mjs",
    "smoke:share-mkv-native": "node scripts/share-mkv-native-smoke.mjs",
    "smoke:share-codec-matrix": "node scripts/share-codec-matrix-smoke.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@mediabunny/ac3": "^1.45.4",
    "@tanstack/react-virtual": "3.14.8",
    "altcha": "^3.0.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "crc-32": "^1.2.2",
    "docx-preview": "0.4.0",
    "exifr": "7.1.3",
    "fflate": "0.8.2",
    "framer-motion": "12.42.2",
    "lucide-react": "1.26.0",
    "mediabunny": "1.45.4",
    "mp4box": "^0.5.2",
    "next": "16.2.11",
    "pdfjs-dist": "5.4.624",
    "plyr": "^3.7.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-aria-components": "^1.18.0",
    "react-dom": "19.2.8",
    "react-photo-album": "3.6.0",
    "tailwind-merge": "^2.2.0",
    "tt-uploader": "^1.6.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yet-another-react-lightbox": "3.32.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
