# LEGACY：仅保留给旧的 /opt/nyy 单进程部署，不属于当前生产拓扑。
# 当前生产环境由 nyy 用户下的 PM2 管理后端。文件使用 .legacy 后缀，禁止安装。

[Unit]
Description=[LEGACY] nyy.app FastAPI backend
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=nyy
Group=nyy
WorkingDirectory=/opt/nyy
EnvironmentFile=/opt/nyy/.env
ExecStart=/opt/nyy/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips="127.0.0.1"
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
UMask=0077

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nyy/var

[Install]
WantedBy=multi-user.target
