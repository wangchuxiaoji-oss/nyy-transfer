[Unit]
Description=Import nyy.app Nginx access events
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=nyy
Group=nyy
SupplementaryGroups=adm
WorkingDirectory=/data/nyy/backend
EnvironmentFile=/data/nyy/backend/.env
ExecStart=/data/nyy/backend/.venv/bin/python /data/nyy/backend/scripts/import_nginx_share_access.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/log/nginx
ReadWritePaths=/data/nyy/backend/runtime
