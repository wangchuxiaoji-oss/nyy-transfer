[Unit]
Description=Maintain nyy operational partitions and privacy retention
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=nyy
Group=nyy
WorkingDirectory=/data/nyy/backend
EnvironmentFile=/data/nyy/backend/.env
ExecStart=/data/nyy/backend/.venv/bin/python /data/nyy/backend/scripts/maintain_operational_data.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/nyy/backend/runtime
