[Unit]
Description=Dispatch pending nyy share email outbox
After=network-online.target postgresql.service postfix.service

[Service]
Type=oneshot
User=nyy
Group=nyy
WorkingDirectory=/data/nyy/backend
EnvironmentFile=/data/nyy/backend/.env
ExecStart=/data/nyy/backend/.venv/bin/python /data/nyy/backend/scripts/dispatch_email_outbox.py --batch-size 100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
