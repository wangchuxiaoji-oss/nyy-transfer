# 应用元信息
APP_NAME=nyy
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:8000
APP_LOG_LEVEL=INFO

# 后端服务
HOST=127.0.0.1
PORT=8000

# 数据库（异步）
DATABASE_URL=postgresql+asyncpg://nyy:nyy@127.0.0.1:5432/nyy
# Alembic 用的同步连接
DATABASE_SYNC_URL=postgresql+psycopg://nyy:nyy@127.0.0.1:5432/nyy
TEST_DATABASE_URL=postgresql+asyncpg://nyy:nyy@127.0.0.1:5432/nyy_test
TEST_DATABASE_SYNC_URL=postgresql+psycopg://nyy:nyy@127.0.0.1:5432/nyy_test

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# IP 来源（MaxMind GeoLite2 City + DB-IP ASN Lite）
GEOIP_CITY_DB=/data/nyy/backend/var/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=/data/nyy/backend/var/geoip/DBIP-ASN-Lite.mmdb
SHARE_ACCESS_RETENTION_DAYS=180
SHARE_VIEW_DEDUPE_MINUTES=10
ADMIN_PREVIEW_SIGN_CONCURRENCY=8
SHARE_ARCHIVE_RETENTION_DAYS=180
# 归档仅支持显式 dry-run/执行，默认不启用自动归档
SHARE_ARCHIVE_ENABLED=false
NGINX_ACCESS_LOG_PATH=/var/log/nginx/nyy_access.json
NGINX_ACCESS_STATE_PATH=/data/nyy/backend/runtime/nginx_access_import_state.json
NGINX_ACCESS_IMPORT_BATCH_SIZE=1000

# 安全
SECRET_KEY=change-me-please-32-bytes-minimum-secret
SESSION_COOKIE_NAME=nyy_session
CSRF_COOKIE_NAME=nyy_csrf

# 短码
SHORT_CODE_LENGTH=6

# 上传 / 配额
GUEST_MAX_FILE_BYTES=2147483648
GUEST_MAX_FILE_SIZE=2147483648
GUEST_MAX_ACTIVE_SHARES=5
USER_MAX_FILE_BYTES=53687091200
USER_MAX_FILE_SIZE=10737418240
USER_MAX_ACTIVE_SHARES=30
GUEST_TTL_HOURS=24
PLATFORM_MAX_FILE_BYTES=10737418240
PLATFORM_MAX_SHARE_BYTES=53687091200
PLATFORM_MAX_FILES_PER_SHARE=500
PLATFORM_MAX_EMPTY_DIRS_PER_SHARE=500
PLATFORM_MAX_RETENTION_HOURS=2160
PLATFORM_MAX_ACTIVE_LINKS=200
PLATFORM_MAX_CONCURRENT_UPLOAD_BATCHES=10
PLATFORM_MAX_REQUEST_BYTES=10737418240
PLATFORM_MAX_REQUEST_FILES=100

# 豆包 file station
DOUBAO_FILE_STATION_BASE_URL=http://127.0.0.1:9190
DOUBAO_FILE_STATION_API_KEY=change-me-doubao-api-key
DOUBAO_SESSION_FILE=/data/nyy/backend/.doubao_session.json
DOUBAO_AUTO_VERIFY_ENABLED=true
DOUBAO_AUTO_VERIFY_HEARTBEAT_INTERVAL_SECONDS=600
DOUBAO_AUTO_VERIFY_PROBE_INTERVAL_SECONDS=1800
DOUBAO_AUTO_VERIFY_FAILURE_NOTIFY_INTERVAL_SECONDS=21600
BARK_PUSH_URL=https://api.day.app/your-bark-key

# 邮件（同机 Postfix / SMTP）
SMTP_HOST=127.0.0.1
SMTP_PORT=25
EMAIL_FROM=noreply@nyy.app
MAILDIR_PATH=/data/nyy-runtime/mail/admin/Maildir
MAILBOX_STORAGE_PATH=/data/nyy-runtime/mailbox

# 认证 - Token
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes!!
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_REFRESH_COOKIE_NAME=nyy_refresh_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# 认证 - ALTCHA 验证码（上线前必须修改密钥）
CAPTCHA_HMAC_SECRET=change-me-captcha-hmac-secret-32bytes!
CAPTCHA_CHALLENGE_TTL_SECONDS=180
CAPTCHA_TOKEN_TTL_SECONDS=300
ALTCHA_ALGORITHM=PBKDF2/SHA-256
ALTCHA_COST=5000

# 认证 - 邮箱验证码（上线前必须修改密钥）
EMAIL_CODE_SECRET=change-me-email-code-secret-32bytes!
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_EMAIL_HOURLY_LIMIT=5
EMAIL_CODE_IP_HOURLY_LIMIT=20
EMAIL_CODE_IP_DAILY_LIMIT=100

# 认证 - 登录风控
LOGIN_EMAIL_FAILURE_CAPTCHA_THRESHOLD=3
LOGIN_IP_FAILURE_CAPTCHA_THRESHOLD=10
LOGIN_IP_FAILURE_RATE_LIMIT=30
